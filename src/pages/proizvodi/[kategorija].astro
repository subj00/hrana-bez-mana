---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import ProductGrid from '@/components/products/ProductGrid.astro';
import Container from '@/components/ui/Container.astro';
import PageIntro from '@/components/ui/PageIntro.astro';
import { ROUTES } from '@/data/navigation';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCategories, getProductsByCategory } from '@/lib/catalog';

export const getStaticPaths = (async () => {
  const categories = await getCategories();
  return categories.map((category) => ({ params: { kategorija: category.slug }, props: { category } }));
}) satisfies GetStaticPaths;

const { category } = Astro.props;
const products = await getProductsByCategory(category.id);
---

<BaseLayout title={category.name}>
  <Container>
    <PageIntro title={category.name} lead={category.description || undefined}>
      <a class="back" href={ROUTES.products}>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M19 12H5M11 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        Svi proizvodi
      </a>
    </PageIntro>

    {
      category.image && typeof category.image.src !== 'string' && (
        <Image
          class={`illustration illustration--${category.tone}`}
          src={category.image.src}
          alt=""
          widths={[280, 440, 640]}
          sizes="20rem"
        />
      )
    }

    {
      products.length > 0 ? (
        <ProductGrid products={products} />
      ) : (
        <p class={`placeholder placeholder--${category.tone}`}>Ponuda iz ove kategorije uskoro stiže.</p>
      )
    }
  </Container>
</BaseLayout>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.7);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color var(--duration) ease;
  }

  .back:hover {
    background: var(--color-blush);
  }

  :global(.illustration) {
    width: min(20rem, 70%);
    height: auto;
    margin: 0 auto var(--space-lg);
    filter: drop-shadow(0 1.25rem 1.5rem rgb(232 141 148 / 0.3));
  }

  .placeholder {
    width: min(100%, 32rem);
    margin: 0 auto var(--space-xl);
    padding: 2rem 1.5rem;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    text-align: center;
  }

  .placeholder--blush {
    background: var(--tone-blush);
  }

  .placeholder--vanilla {
    background: var(--tone-vanilla);
  }

  .placeholder--sage {
    background: var(--tone-sage);
  }

  .placeholder--peach {
    background: var(--tone-peach);
  }
</style>
