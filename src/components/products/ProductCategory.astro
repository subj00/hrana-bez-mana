---
import ProductGrid from '@/components/products/ProductGrid.astro';
import type { Category, Product } from '@/types/catalog';

interface Props {
  category: Category;
  products: Product[];
}

const { category, products } = Astro.props;
const headingId = `${category.slug}-naslov`;
---

<section id={category.slug} aria-labelledby={headingId} data-reveal>
  <h3 id={headingId}>{category.name}</h3>
  {category.description && <p>{category.description}</p>}
  {products.length > 0 ? <ProductGrid products={products} /> : <p>Uskoro u ponudi.</p>}
</section>
