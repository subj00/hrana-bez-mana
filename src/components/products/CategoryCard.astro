---
import { Image } from 'astro:assets';
import { categoryHref } from '@/data/navigation';
import type { Category } from '@/types/catalog';

interface Props {
  category: Category;
  /** Heading level of the card title, so it fits the page outline it is placed in. */
  headingLevel?: 2 | 3;
  /** On phones, shrink to a miniature so four cards fit in one row. */
  compactOnMobile?: boolean;
}

const { category, headingLevel = 2, compactOnMobile = false } = Astro.props;
const Heading = `h${headingLevel}` as const;
// Illustrations are local assets; a remote (string) source would need explicit dimensions.
const illustration = category.image && typeof category.image.src !== 'string' ? category.image.src : undefined;
---

<!-- The whole card is the link; the illustration rises out of its top edge. -->
<a
  class:list={['card', `card--${category.tone}`, { 'card--compact': compactOnMobile }]}
  href={categoryHref(category.slug)}
>
  {
    illustration && (
      <span class="card__media">
        <Image
          class="card__image"
          src={illustration}
          alt=""
          widths={[220, 340, 520]}
          sizes="(max-width: 48rem) 25vw, 15rem"
        />
      </span>
    )
  }
  <span class="card__footer">
    <Heading class="card__name">{category.name}</Heading>
    <span class="card__arrow" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18">
        <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </span>
  </span>
</a>

<style>
  .card {
    --pop: 22%;

    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    min-height: var(--card-height, clamp(9.75rem, 13.2vw, 12.75rem));
    padding: 0.875rem 0.875rem 0.875rem 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--card-bg);
    box-shadow:
      var(--shadow-soft),
      inset 0 0 0 1px rgb(255 255 255 / 0.6);
    text-decoration: none;
    transition:
      transform 400ms var(--ease-out),
      box-shadow 400ms ease;
  }

  .card--blush {
    --card-bg: var(--tone-blush);
  }

  .card--vanilla {
    --card-bg: var(--tone-vanilla);
  }

  .card--sage {
    --card-bg: var(--tone-sage);
  }

  .card--peach {
    --card-bg: var(--tone-peach);
  }

  /* Illustration area: the top of the card, extended upwards past its edge. */
  .card__media {
    position: absolute;
    inset: calc(-1 * var(--pop)) 6% 34% 6%;
    pointer-events: none;
  }

  .card :global(.card__image) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 0.75rem 0.75rem rgb(69 39 28 / 0.14));
    transition: transform 400ms var(--ease-out);
  }

  .card__footer {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .card__name {
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    font-weight: 600;
    line-height: 1.2;
  }

  .card__arrow {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-cream-white);
    box-shadow: 0 0.375rem 0.75rem -0.375rem rgb(69 39 28 / 0.3);
    transition:
      background-color var(--duration) ease,
      color var(--duration) ease;
  }

  .card__arrow svg {
    transition: transform var(--duration) var(--ease-out);
  }

  .card:active {
    transform: scale(0.98);
  }

  /*
   * Phones, compact variant: a miniature of the desktop card, so all four fit side by side
   * even at 320px. Here everything is in normal flow, stacked and centred:
   * illustration -> small gap -> name -> small gap -> arrow. The illustration still rises
   * out of the top edge, and the arrow sits at the bottom so all four line up.
   */
  @media (max-width: 47.99rem) {
    .card--compact {
      --pop: clamp(1rem, 7vw, 1.75rem);

      justify-content: flex-start;
      min-height: 0;
      padding: clamp(0.4rem, 2vw, 0.75rem) clamp(0.4rem, 2vw, 0.75rem) clamp(0.5rem, 2.4vw, 0.875rem);
      border-radius: clamp(1rem, 5vw, 1.75rem);
    }

    .card--compact .card__media {
      position: relative;
      inset: auto;
      width: 100%;
      aspect-ratio: 6 / 5;
      margin-top: calc(-1 * var(--pop));
    }

    /* Fill the fixed-size box (so a squarer image cannot stretch it) and sit on its
       bottom edge, right above the name. */
    .card--compact :global(.card__image) {
      position: absolute;
      inset: 0;
      object-position: center bottom;
    }

    .card--compact .card__footer {
      flex: 1;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      gap: clamp(0.375rem, 2vw, 0.5rem);
      margin-top: clamp(0.5rem, 2.6vw, 0.75rem);
      text-align: center;
    }

    .card--compact .card__name {
      font-size: clamp(0.6875rem, 3.1vw, 1rem);
      line-height: 1.15;
    }

    /* Pushed to the bottom, so arrows line up even if one name wraps to two lines. */
    .card--compact .card__arrow {
      width: clamp(1.375rem, 6.5vw, 2rem);
      height: clamp(1.375rem, 6.5vw, 2rem);
      margin-top: auto;
    }

    .card--compact .card__arrow svg {
      width: 60%;
      height: auto;
    }
  }

  @media (hover: hover) {
    .card:hover {
      box-shadow:
        var(--shadow-float),
        inset 0 0 0 1px rgb(255 255 255 / 0.6);
      transform: translateY(-0.375rem);
    }

    .card:hover :global(.card__image) {
      transform: translateY(-0.25rem) scale(1.04);
    }

    .card:hover .card__arrow {
      background: var(--color-chocolate);
      color: var(--color-cream-white);
    }

    .card:hover .card__arrow svg {
      transform: translateX(2px);
    }
  }
</style>
