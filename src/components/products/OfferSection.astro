---
import { Image } from 'astro:assets';
import ImageCarousel from '@/components/ui/ImageCarousel.astro';
import Section from '@/components/ui/Section.astro';
import VerticalCarousel from '@/components/ui/VerticalCarousel.astro';
import { getAsset } from '@/lib/assets';
import type { Offer } from '@/data/offers';
import type { Category } from '@/types/catalog';

interface Props {
  category: Category;
  offer: Offer;
  /** Desktop: photos on the left and the card on the right (alternates with the next section). */
  reversed?: boolean;
}

const { category, offer, reversed = false } = Astro.props;
const titleImage = category.titleImage && typeof category.titleImage.src !== 'string' ? category.titleImage.src : undefined;

const highlights = offer.highlights.map((highlight) => ({ ...highlight, src: getAsset(highlight.image) }));

const gallery = offer.gallery.flatMap((file, index) => {
  const src = getAsset(file);
  return src ? [{ src, alt: `${offer.galleryAlt} ${index + 1}` }] : [];
});

// Every price row in the card gets a running index, so the rows reveal one after another.
let row = 0;
const groups = offer.groups?.map((group) => ({
  ...group,
  index: row++,
  items: group.items?.map((item) => ({ ...item, index: row++ })),
}));
const items = offer.items?.map((item) => ({ ...item, index: row++ }));

// Each side slides in from its own edge, so a reversed section mirrors the motion too.
const cardFrom = reversed ? 'right' : 'left';
const galleryFrom = reversed ? 'left' : 'right';
---

<!--
  A category presented as a price card next to a vertical photo carousel (desktop), or
  card then horizontal swipe gallery (below 64rem). Without photos the card sits centred.
-->
<Section
  id={category.slug}
  title={category.name}
  titleImage={titleImage}
  titleTrim={category.titleTrim}
  background={offer.background}
  ornament={false}
  snug
>
  <div class:list={['offer', { 'offer--gallery': gallery.length > 0, 'offer--reversed': reversed }]}>
    <article class="offer__card" data-reveal={cardFrom}>
      {offer.heading && <h3 class="offer__heading">{offer.heading}</h3>}
      {offer.lead && <p class="offer__lead">{offer.lead}</p>}

      {
        offer.varieties && (
          <ol class="offer__varieties" role="list">
            {offer.varieties.map((variety, index) => (
              <li class="variety">
                <span class="variety__number" aria-hidden="true">
                  {index + 1}
                </span>
                {variety}
              </li>
            ))}
          </ol>
        )
      }

      {
        groups && (
          <div class="offer__groups">
            <h3 class="sr-only">Cene</h3>
            {groups.map((group) => (
              <section class="group">
                <div class="price price--group" style={`--i: ${group.index}`}>
                  <div class="price__label">
                    <h4 class="price__name group__title">{group.title}</h4>
                    {group.detail && <span class="price__detail">{group.detail}</span>}
                  </div>
                  {group.price && <span class="price__badge">{group.price}</span>}
                </div>
                {group.varieties && (
                  <ol class="offer__varieties group__varieties" role="list">
                    {group.varieties.map((variety, index) => (
                      <li class="variety">
                        <span class="variety__number" aria-hidden="true">
                          {index + 1}
                        </span>
                        {variety}
                      </li>
                    ))}
                  </ol>
                )}
                {group.note && <p class="price__detail group__note">{group.note}</p>}
                {group.items && (
                  <ul class="offer__prices group__items" role="list">
                    {group.items.map((item) => (
                      <li class="price price--sub" style={`--i: ${item.index}`}>
                        <span class="price__label">
                          <span class="price__name">{item.name}</span>
                        </span>
                        <span class="price__badge">{item.price}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            ))}
          </div>
        )
      }

      {
        items && (
          <div class="offer__pricing">
            {offer.pricesTitle ? <h3 class="offer__subhead">{offer.pricesTitle}</h3> : <h3 class="sr-only">Cene</h3>}
            <ul class="offer__prices" role="list">
              {
                items.map((item) => (
                  <li class="price" style={`--i: ${item.index}`}>
                    <span class="price__label">
                      <span class="price__name">{item.name}</span>
                      {item.detail && <span class="price__detail">{item.detail}</span>}
                    </span>
                    <span class="price__badge">{item.price}</span>
                  </li>
                ))
              }
            </ul>
            {offer.note && <p class="offer__note">{offer.note}</p>}
          </div>
        )
      }

      <ul class="offer__highlights" role="list">
        {
          highlights.map((highlight, index) => (
            <li class="highlight" style={`--i: ${index}`}>
              {highlight.src ? (
                <Image class="highlight__image" src={highlight.src} alt="" widths={[160, 320]} sizes="6rem" />
              ) : (
                <span class="highlight__placeholder" aria-hidden="true" />
              )}
              <p class="highlight__text">{highlight.text}</p>
            </li>
          ))
        }
      </ul>
    </article>

    {
      gallery.length > 0 && (
        <div class="offer__gallery" data-reveal={galleryFrom} style="--reveal-delay: 150ms">
          <div class="offer__gallery-vertical">
            <VerticalCarousel images={gallery} label={offer.galleryLabel} />
          </div>
          <div class="offer__gallery-horizontal">
            <ImageCarousel images={gallery} label={offer.galleryLabel} />
          </div>
        </div>
      )
    }
  </div>
</Section>

<style>
  .offer {
    display: grid;
    justify-items: center;
    gap: clamp(1.75rem, 4vw, 2.5rem);
  }

  .offer__card {
    display: grid;
    gap: clamp(1.25rem, 3vw, 1.75rem);
    width: min(100%, 36rem);
    padding: clamp(1.25rem, 4vw, 2.25rem);
    border-radius: 2rem;
    background: rgb(255 252 248 / 0.8);
    box-shadow:
      var(--shadow-soft),
      inset 0 0 0 1px rgb(255 255 255 / 0.9);
  }

  .offer__lead {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.6vw, 1.1875rem);
    font-weight: 600;
    line-height: 1.5;
    text-align: center;
  }

  .offer__heading {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    font-weight: 800;
    text-align: center;
  }

  /* ---------- Varieties: a numbered list with small pink beads ---------- */

  .offer__varieties {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }

  .variety {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 3.4vw, 1.0625rem);
    font-weight: 600;
    line-height: 1.35;
  }

  .variety__number {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--color-blush);
    font-size: 0.8125rem;
    font-weight: 800;
    color: var(--color-strawberry);
    translate: 0 0.0625rem;
  }

  /* Label above the price rows, set apart from what comes before by a hairline. */
  .offer__subhead {
    padding: 1rem 0.25rem 0.25rem;
    border-top: 1px solid rgb(69 39 28 / 0.08);
    font-size: clamp(1rem, 2.2vw, 1.125rem);
    font-weight: 700;
    text-align: center;
  }

  /* ---------- Groups: separate products, each with its own title row ---------- */

  .offer__groups {
    display: grid;
  }

  .group {
    display: grid;
    gap: 0.25rem;
    padding-block: 0.375rem;
  }

  .group + .group {
    border-top: 1px solid rgb(69 39 28 / 0.08);
  }

  .group .price {
    padding-block: 0.625rem;
  }

  .group__title {
    font-weight: 800;
  }

  .group__varieties {
    gap: 0.375rem;
    padding: 0 0.25rem 0.5rem;
  }

  .group__note {
    padding: 0 0.25rem 0.5rem;
  }

  /* Several products within one group: indented under its title. */
  .group__items {
    padding-left: 0.75rem;
  }

  .price--sub .price__name {
    font-size: clamp(0.875rem, 3.3vw, 1.0625rem);
    font-weight: 600;
  }

  /* ---------- Prices: rows inside the card, separated by hairlines ---------- */

  .offer__pricing {
    display: grid;
    gap: 0.5rem;
  }

  .offer__prices {
    display: grid;
  }

  .price {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: 0.875rem 0.25rem;
  }

  .price + .price {
    border-top: 1px solid rgb(69 39 28 / 0.08);
  }

  .price__label {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }

  .price__name {
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 3.6vw, 1.1875rem);
    font-weight: 700;
    line-height: 1.25;
  }

  .price__detail {
    font-size: clamp(0.8125rem, 3vw, 0.9375rem);
    line-height: 1.35;
    color: var(--color-text-muted);
  }

  .price__badge {
    flex: none;
    padding: 0.5rem clamp(0.75rem, 3vw, 1.125rem);
    border-radius: var(--radius-pill);
    background: linear-gradient(135deg, var(--color-pink) 0%, #f2b0b8 100%);
    font-family: var(--font-display);
    font-size: clamp(0.875rem, 3.2vw, 1.0625rem);
    font-weight: 800;
    white-space: nowrap;
    transition: transform var(--duration) var(--ease-out);
  }

  @media (hover: hover) {
    .price:hover .price__badge {
      transform: scale(1.05);
    }
  }

  .offer__note {
    padding-inline: 0.25rem;
    font-size: clamp(0.8125rem, 3vw, 0.9375rem);
    line-height: 1.45;
    color: var(--color-text-muted);
    text-align: center;
  }

  /* ---------- Highlights: two small pink tiles ---------- */

  .offer__highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 2.5vw, 1rem);
  }

  .highlight {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    height: 100%;
    min-height: clamp(6.5rem, 22vw, 8.5rem);
    padding: clamp(0.875rem, 3vw, 1.25rem) clamp(0.75rem, 2.5vw, 1rem);
    border-radius: var(--radius-lg);
    background: var(--tone-blush);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.6);
    text-align: center;
  }

  .offer :global(.highlight__image) {
    width: auto;
    height: clamp(3rem, 11vw, 4.5rem);
    object-fit: contain;
    filter: drop-shadow(0 0.5rem 0.75rem rgb(69 39 28 / 0.12));
  }

  /* Holds the image's place until the file is added, so the tile keeps its layout. */
  .highlight__placeholder {
    width: clamp(3rem, 11vw, 4.5rem);
    height: clamp(3rem, 11vw, 4.5rem);
    border: 2px dashed rgb(232 141 148 / 0.45);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.35);
  }

  .highlight__text {
    font-family: var(--font-display);
    font-size: clamp(0.875rem, 3.2vw, 1.0625rem);
    font-weight: 700;
    line-height: 1.3;
  }

  /*
   * Scroll reveal inside the card: once the card slides in, its price rows follow one
   * by one, then the two tiles scale up one after the other.
   */
  :global([data-reveal-ready]) .price,
  :global([data-reveal-ready]) .highlight {
    transition:
      opacity var(--reveal-duration) var(--ease-out),
      transform var(--reveal-duration) var(--ease-out);
  }

  :global([data-reveal-ready]) .price {
    transition-delay: calc(200ms + var(--i) * var(--reveal-stagger));
  }

  :global([data-reveal-ready]) .highlight {
    transition-delay: calc(560ms + var(--i) * var(--reveal-stagger));
  }

  :global([data-reveal-ready]) .offer__card:not([data-revealed]) .price {
    opacity: 0;
    transform: translate3d(0, 0.75rem, 0);
  }

  :global([data-reveal-ready]) .offer__card:not([data-revealed]) .highlight {
    opacity: 0;
    transform: scale(0.92);
  }

  /* ---------- Gallery ---------- */

  .offer__gallery {
    width: 100%;
  }

  .offer__gallery-vertical {
    display: none;
  }

  /* Desktop: card 45%, photos 55%, side by side; reversed puts the photos first. */
  @media (min-width: 64rem) {
    .offer--gallery {
      grid-template-columns: minmax(0, 45fr) minmax(0, 55fr);
      align-items: center;
      gap: clamp(2rem, 4vw, 4rem);
    }

    .offer--gallery.offer--reversed {
      grid-template-columns: minmax(0, 55fr) minmax(0, 45fr);
    }

    .offer--reversed .offer__gallery {
      order: -1;
    }

    .offer--gallery .offer__card {
      width: 100%;
    }

    .offer__gallery-vertical {
      display: block;
    }

    .offer__gallery-horizontal {
      display: none;
    }
  }
</style>
