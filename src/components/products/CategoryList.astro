---
import CategoryCard from '@/components/products/CategoryCard.astro';
import type { Category } from '@/types/catalog';

interface Props {
  categories: Category[];
  headingLevel?: 2 | 3;
}

const { categories, headingLevel } = Astro.props;
---

<!-- One row of four at every size; on phones the cards shrink to fit. -->
<ul class="categories" role="list">
  {
    categories.map((category, index) => (
      <li class="categories__item" style={`--i: ${index}`}>
        <CategoryCard category={category} headingLevel={headingLevel} compactOnMobile />
      </li>
    ))
  }
</ul>

<style>
  /* Room above the cards for the illustrations that rise out of them. */
  .categories {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.625rem, 1.4vw, 1.25rem);
    padding-top: var(--cards-rise-space, clamp(2.25rem, 3.5vw, 3rem));
  }

  /* The cards rise in one after another as part of the hero's entrance (CSS animation,
     so it also waits behind the cake intro). */
  .categories__item {
    animation: fade-up 750ms var(--ease-out) calc(500ms + var(--i) * var(--reveal-stagger)) backwards;
  }

  @media (max-width: 47.99rem) {
    /* Still four across: narrow gaps, and room above for the illustrations to rise into. */
    .categories {
      gap: clamp(0.375rem, 2vw, 0.75rem);
      padding-top: clamp(1.25rem, 6vw, 2.25rem);
    }
  }
</style>
