---
import CategoryCard from '@/components/products/CategoryCard.astro';
import type { Category } from '@/types/catalog';

interface Props {
  categories: Category[];
  /**
   * `row`: one row of four at every size; on phones the cards shrink to fit (home hero).
   * `grid`: two columns on phones, four from tablets up (products page).
   */
  layout?: 'row' | 'grid';
  headingLevel?: 2 | 3;
}

const { categories, layout = 'grid', headingLevel } = Astro.props;
---

<ul class:list={['categories', `categories--${layout}`]} role="list">
  {
    categories.map((category) => (
      <li class="categories__item">
        <CategoryCard category={category} headingLevel={headingLevel} compactOnMobile={layout === 'row'} />
      </li>
    ))
  }
</ul>

<style>
  /* Room above the cards for the illustrations that rise out of them. */
  .categories {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.625rem, 1.4vw, 1.25rem);
    padding-top: var(--cards-rise-space, clamp(2.25rem, 3.5vw, 3rem));
  }

  .categories--grid {
    row-gap: clamp(3rem, 6vw, 4rem);
  }

  @media (max-width: 47.99rem) {
    .categories {
      --card-height: 10.5rem;
    }

    .categories--grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Still four across: narrow gaps, and room above for the illustrations to rise into. */
    .categories--row {
      gap: clamp(0.375rem, 2vw, 0.75rem);
      padding-top: clamp(1.25rem, 6vw, 2.25rem);
    }
  }
</style>
