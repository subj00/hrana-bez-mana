---
import Container from '@/components/ui/Container.astro';
import { site } from '@/data/site';

const year = new Date().getFullYear();
---

<!--
  Editorial footer: a large two-line statement on the left, the brand on the right, and
  a thin divider above the copyright and the designer credit. Dark chocolate, cream type,
  one pastel-pink accent. Behind the panel is the colour of the section above it, so its
  rounded top corners blend into the page.
-->
<footer class="footer">
  <div class="footer__panel">
    <Container>
      <div class="footer__main" data-reveal="up">
        <p class="footer__statement">
          Svaki zalogaj<br />
          ima svoju <span class="footer__accent">priču.</span>
        </p>

        <div class="footer__brand">
          <p class="footer__name">{site.name}</p>
          <p class="footer__tagline">Torte • Kolači • Slani zalogaji</p>
        </div>
      </div>

      <div class="footer__bottom">
        <p>&copy; {year} {site.name}</p>
        <p class="footer__credit">Design &amp; Development by <span class="footer__signature">subj</span></p>
      </div>
    </Container>
  </div>
</footer>

<style>
  /* Fills the space outside the panel's rounded corners with the last section's colour. */
  .footer {
    --footer-cream: #fff3e8;
    --footer-pink: #f6c7cd;

    background: var(--bg-page-end);
  }

  .footer__panel {
    padding-block: clamp(3rem, 6vw, 4.25rem) clamp(1.25rem, 2.5vw, 1.75rem);
    padding-inline: clamp(0rem, 3vw, 2rem);
    border-radius: clamp(1.5rem, 4vw, 2.5rem) clamp(1.5rem, 4vw, 2.5rem) 0 0;
    background:
      radial-gradient(60% 120% at 100% 0%, rgb(232 141 148 / 0.12) 0%, transparent 60%),
      var(--color-chocolate);
    color: var(--footer-cream);
  }

  /* ---------- Statement and brand ---------- */

  .footer__main {
    display: grid;
    align-items: end;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  /* The dominant element: oversized, tight, two lines. */
  .footer__statement {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .footer__accent {
    display: inline-block;
    color: var(--footer-pink);
    transition:
      transform 500ms var(--ease-out),
      color 500ms ease;
  }

  @media (hover: hover) {
    .footer__accent:hover {
      color: #f9d3d8;
      transform: translateY(-3px) rotate(-2deg);
    }
  }

  .footer__name {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 800;
  }

  .footer__tagline {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  /* ---------- Bottom line ---------- */

  .footer__bottom {
    display: grid;
    gap: 0.375rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 243 232 / 0.14);
    font-size: 0.8125rem;
    color: rgb(255 243 232 / 0.6);
  }

  /* A small designer signature, quieter than everything above it. */
  .footer__credit {
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  .footer__signature {
    font-weight: 700;
    color: var(--footer-cream);
    transition: color var(--duration) ease;
  }

  .footer__signature:hover {
    color: var(--footer-pink);
  }

  /* Desktop: statement left, brand right; copyright and credit on opposite sides. */
  @media (min-width: 48rem) {
    .footer__main {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .footer__brand {
      text-align: end;
    }

    .footer__bottom {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
    }
  }
</style>
