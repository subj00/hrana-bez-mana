---
import { navItems } from '@/data/navigation';
---

<nav class="nav" aria-label="Glavna navigacija" data-nav>
  <!-- Shown only on small screens, and only once the script below has run. -->
  <button
    class="nav__toggle"
    type="button"
    aria-label="Otvori meni"
    aria-expanded="false"
    aria-controls="glavni-meni"
    data-nav-toggle
  >
    <span class="nav__bars" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </span>
  </button>
  <div class="nav__scrim" data-nav-scrim></div>
  <ul class="nav__list" id="glavni-meni" role="list">
    {
      navItems.map((item, index) => (
        <li class="nav__item" style={`--i: ${index}`}>
          <a class="nav__link" href={item.href}>
            <span class="nav__index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="nav__label">{item.label}</span>
            <span class="nav__arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16">
                <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = nav?.querySelector<HTMLButtonElement>('[data-nav-toggle]');

  // Mobile menu: a disclosure that closes on link click, outside click, Escape and focus loss.
  if (nav && toggle) {
    const root = document.documentElement;
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Zatvori meni' : 'Otvori meni');
      // Locks page scroll and makes the header solid (see global.css and Header.astro).
      root.toggleAttribute('data-menu-open', open);
    };

    // Without JavaScript the links simply stay visible.
    nav.dataset.enhanced = '';

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    document.addEventListener('click', (event) => {
      if (!isOpen() || !(event.target instanceof Element)) return;
      const outside = !nav.contains(event.target);
      if (outside || event.target.closest('a, [data-nav-scrim]')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });

    nav.addEventListener('focusout', (event) => {
      if (isOpen() && event.relatedTarget instanceof Node && !nav.contains(event.relatedTarget)) {
        setOpen(false);
      }
    });

    // Leaving the mobile layout (rotation, resize) must not leave the page scroll-locked.
    window.matchMedia('(max-width: 40rem)').addEventListener('change', (event) => {
      if (!event.matches) setOpen(false);
    });
  }

  // Marks the link of the section currently crossing the middle of the viewport.
  if (nav) {
    const links = new Map<Element, HTMLAnchorElement>();

    for (const link of nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')) {
      const section = document.getElementById(link.hash.slice(1));
      if (section) links.set(section, link);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const link of links.values()) link.removeAttribute('aria-current');
          links.get(entry.target)?.setAttribute('aria-current', 'location');
        }
      },
      { rootMargin: '-50% 0px -50% 0px' },
    );

    for (const section of links.keys()) observer.observe(section);
  }
</script>

<style>
  .nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) clamp(1.5rem, 4vw, 3.5rem);
  }

  .nav__link {
    position: relative;
    display: inline-block;
    padding-block: var(--space-sm);
    font-family: var(--font-nav);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
  }

  /* Underline that grows in on hover and stays for the active section. */
  .nav__link::after {
    content: '';
    position: absolute;
    inset: auto 0 0.125rem;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration) var(--ease-out);
  }

  .nav__link:hover::after,
  .nav__link[aria-current]::after {
    transform: scaleX(1);
  }

  /* Mobile-menu-only parts. */
  .nav__toggle,
  .nav__scrim,
  .nav__index,
  .nav__arrow {
    display: none;
  }

  /* Desktop: links follow the header in with a slight stagger. */
  @media (min-width: 40.0625rem) {
    .nav__item {
      animation: fade-down 600ms var(--ease-out) calc(200ms + var(--i) * 70ms) backwards;
    }
  }

  @media (max-width: 40rem) {
    .nav:not([data-enhanced]) .nav__list {
      justify-content: flex-end;
      gap: 0 var(--space-md);
    }

    /* Hamburger that morphs into an X. */
    .nav[data-enhanced] .nav__toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      margin-inline-end: -0.625rem;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: transparent;
      color: inherit;
      cursor: pointer;
      transition: background-color var(--duration) ease;
    }

    .nav__toggle:hover,
    .nav__toggle[aria-expanded='true'] {
      background: var(--color-mint);
    }

    .nav__bars {
      position: relative;
      width: 1.375rem;
      height: 1rem;
    }

    .nav__bars span {
      position: absolute;
      right: 0;
      width: 100%;
      height: 2px;
      border-radius: 2px;
      background: currentColor;
      transition:
        transform var(--duration) var(--ease-out),
        opacity var(--duration-fast) ease;
    }

    .nav__bars span:nth-child(1) {
      top: 0;
    }

    .nav__bars span:nth-child(2) {
      top: calc(50% - 1px);
    }

    .nav__bars span:nth-child(3) {
      bottom: 0;
    }

    .nav__toggle[aria-expanded='true'] .nav__bars span:nth-child(1) {
      transform: translateY(0.4375rem) rotate(45deg);
    }

    .nav__toggle[aria-expanded='true'] .nav__bars span:nth-child(2) {
      opacity: 0;
      transform: scaleX(0);
    }

    .nav__toggle[aria-expanded='true'] .nav__bars span:nth-child(3) {
      transform: translateY(-0.4375rem) rotate(-45deg);
    }

    /* Dims the page below the header; absolute (not fixed) because the header's
       backdrop-filter would otherwise become its containing block. */
    .nav[data-enhanced] .nav__scrim {
      position: absolute;
      top: 100%;
      left: 0;
      display: block;
      width: 100%;
      height: 100lvh;
      background: rgb(47 47 47 / 0.3);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity var(--duration) ease,
        visibility 0s var(--duration);
    }

    /* The panel: a floating card under the header. */
    .nav[data-enhanced] .nav__list {
      position: absolute;
      top: calc(100% + var(--space-sm));
      inset-inline: var(--page-gutter);
      isolation: isolate;
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0;
      padding: var(--space-sm) 1.5rem;
      overflow: hidden;
      border-radius: 1.5rem;
      background: var(--color-bg);
      box-shadow:
        0 0 0 1px rgb(47 47 47 / 0.05),
        0 1.5rem 3rem -1rem rgb(60 30 40 / 0.3);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.75rem) scale(0.98);
      transform-origin: top right;
      transition:
        opacity var(--duration) ease,
        transform var(--duration) var(--ease-out),
        visibility 0s var(--duration);
    }

    /* Soft pink accent echoing the hero shape. */
    .nav[data-enhanced] .nav__list::before {
      content: '';
      position: absolute;
      top: -3.5rem;
      right: -3rem;
      z-index: -1;
      width: 11rem;
      height: 10rem;
      border-radius: 58% 42% 45% 55% / 50% 55% 45% 50%;
      background: var(--color-blush);
      opacity: 0.6;
    }

    .nav[data-enhanced] .nav__toggle[aria-expanded='true'] ~ .nav__scrim {
      opacity: 1;
      visibility: visible;
      transition-delay: 0s;
    }

    .nav[data-enhanced] .nav__toggle[aria-expanded='true'] ~ .nav__list {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }

    .nav[data-enhanced] .nav__item {
      opacity: 0;
      transform: translateY(0.5rem);
      transition:
        opacity var(--duration) ease,
        transform var(--duration) var(--ease-out);
    }

    .nav[data-enhanced] .nav__item + .nav__item {
      border-top: 1px solid rgb(47 47 47 / 0.08);
    }

    .nav[data-enhanced] .nav__toggle[aria-expanded='true'] ~ .nav__list .nav__item {
      opacity: 1;
      transform: none;
      transition-delay: calc(80ms + var(--i) * 60ms);
    }

    .nav[data-enhanced] .nav__link {
      display: flex;
      align-items: center;
      gap: var(--space-md);
      padding-block: 1.125rem;
      font-size: 1rem;
    }

    .nav[data-enhanced] .nav__link::after {
      content: none;
    }

    .nav[data-enhanced] .nav__index {
      display: inline;
      font-size: 0.6875rem;
      font-variant-numeric: tabular-nums;
      color: var(--color-text-muted);
    }

    /* Mint marker under the label of the active section. */
    .nav[data-enhanced] .nav__label {
      box-shadow: inset 0 0 0 transparent;
      transition: box-shadow var(--duration) ease;
    }

    .nav[data-enhanced] .nav__link[aria-current] .nav__label {
      box-shadow: inset 0 -0.5em 0 var(--color-mint);
    }

    .nav[data-enhanced] .nav__arrow {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      margin-inline-start: auto;
      border-radius: 50%;
      background: var(--color-mint);
      transition:
        background-color var(--duration) ease,
        transform var(--duration) var(--ease-out);
    }

    .nav[data-enhanced] .nav__link:hover .nav__arrow,
    .nav[data-enhanced] .nav__link:active .nav__arrow {
      background: var(--color-mint-strong);
      transform: translateX(0.25rem);
    }
  }
</style>
