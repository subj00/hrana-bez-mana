---
import { Image } from 'astro:assets';
import { getAsset } from '@/lib/assets';

/**
 * One cloud in the scene. Position is the cloud's centre in % of the parent section,
 * width is in % of its width; `mobile` overrides them on small screens, or `false` leaves
 * the cloud out there. Opacity, blur and size together set how far away a cloud feels.
 */
export interface Cloud {
  x: number;
  y: number;
  width: number;
  opacity: number;
  blur?: number;
  flip?: boolean;
  /**
   * Back-and-forth drift: pixels travelled each way (negative x = drifts left first) and
   * the seconds that one way takes. Bigger clouds move further but more slowly.
   */
  drift: { x: number; y: number; seconds: number };
  mobile?: { x: number; y: number; width: number } | false;
}


interface Props {
  clouds: Cloud[];
}

const { clouds } = Astro.props;
const cloud = getAsset('decoration-cloud.png');
---

{
  cloud && (
    <div class="clouds" aria-hidden="true">
      {clouds.map((c, index) => (
        <span
          class:list={['cloud', { 'cloud--desktop': c.mobile === false }]}
          style={[
            `--x: ${c.x}%`,
            `--y: ${c.y}%`,
            `--w: ${c.width}`,
            c.mobile ? `--mx: ${c.mobile.x}%; --my: ${c.mobile.y}%; --mw: ${c.mobile.width}` : '',
            `--o: ${c.opacity}`,
            `--blur: ${c.blur ?? 0}px`,
            `--flip: ${c.flip ? -1 : 1}`,
            `--dx: ${c.drift.x}px`,
            `--dy: ${c.drift.y}px`,
            `--dur: ${c.drift.seconds}s`,
            // Negative delays start each cloud part-way through its drift, so they never move in step.
            `--delay: -${((index * 3.7) % c.drift.seconds).toFixed(1)}s`,
          ]
            .filter(Boolean)
            .join('; ')}
        >
          <Image class="cloud__image" src={cloud} alt="" width={cloud.width} loading="eager" />
        </span>
      ))}
    </div>
  )
}

<style>
  /*
   * Fills the parent section behind everything (the parent needs position: relative and
   * isolation: isolate); clouds are positioned and sized against it.
   */
  .clouds {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: clip;
    container-type: size;
    pointer-events: none;
  }

  /* The wrapper places, sizes, flips and fades the cloud; it is never animated. */
  .cloud {
    position: absolute;
    top: var(--y);
    left: var(--x);
    width: calc(var(--w) * 1cqw);
    opacity: var(--o);
    filter: blur(var(--blur));
    transform: translate(-50%, -50%) scaleX(var(--flip));
    animation: fade-in 1600ms ease-out backwards;
  }

  /* The image inside does the drifting, so its transform never fights the placement. */
  .cloud :global(.cloud__image) {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
    will-change: transform;
    animation: cloud-drift var(--dur) ease-in-out var(--delay) infinite alternate;
  }

  @keyframes cloud-drift {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(calc(var(--dx) * var(--drift-scale, 1)), calc(var(--dy) * var(--drift-scale, 1)), 0);
    }
  }

  @media (max-width: 47.99rem) {
    /* Phones: shorter drift paths. */
    .clouds {
      --drift-scale: 0.6;
    }

    .cloud {
      top: var(--my, var(--y));
      left: var(--mx, var(--x));
      width: calc(var(--mw, var(--w)) * 1cqw);
    }

    .cloud--desktop {
      display: none;
    }
  }
</style>
