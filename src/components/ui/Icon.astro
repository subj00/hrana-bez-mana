---
/** Small line icons shared across the site. They take their colour from `currentColor`. */
interface Props {
  name: 'instagram' | 'phone' | 'arrow';
  /** Rendered size in px; omit to size the icon with CSS instead. */
  size?: number;
  class?: string;
}

const { name, size, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" focusable="false">
  {
    name === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5.5" fill="none" stroke="currentColor" stroke-width="1.8" />
        <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8" />
        <circle cx="17.3" cy="6.7" r="1.15" fill="currentColor" />
      </>
    )
  }
  {
    name === 'phone' && (
      <path
        d="M6.6 3.6l2.3-.5a1.3 1.3 0 0 1 1.5.8l1.1 2.7a1.3 1.3 0 0 1-.4 1.5l-1.4 1.1a10.7 10.7 0 0 0 5 5l1.1-1.4a1.3 1.3 0 0 1 1.5-.4l2.7 1.1a1.3 1.3 0 0 1 .8 1.5l-.5 2.3a1.3 1.3 0 0 1-1.3 1C9.9 20.3 3.7 14.1 3.7 5a1.3 1.3 0 0 1 1-1.3z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linejoin="round"
      />
    )
  }
  {
    name === 'arrow' && (
      <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    )
  }
</svg>
