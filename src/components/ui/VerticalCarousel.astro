---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  /** Accessible name for the carousel region. */
  label: string;
}

const { images, label } = Astro.props;
const ratio = images[0] ? images[0].src.width / images[0].src.height : 4 / 5;
---

<!--
  Vertical image carousel: one large photo with the top of the next one peeking in below.
  Moved by the arrow buttons, the dots, the keyboard (↑/↓ when focused) or by dragging
  with a mouse. It never takes over the scroll wheel or touch scrolling, so it cannot
  get in the way of scrolling the page.
-->
{
  images.length > 0 && (
    <div
      class="vcarousel"
      role="region"
      aria-roledescription="karusel"
      aria-label={label}
      style={`--ratio: ${ratio}`}
      data-vcarousel
    >
      <div class="vcarousel__viewport" tabindex="0" data-vcarousel-viewport>
        <ul class="vcarousel__track" role="list" data-vcarousel-track>
          {images.map((image, index) => (
            <li class="vcarousel__slide" aria-label={`${index + 1} od ${images.length}`} data-active={index === 0 ? '' : undefined}>
              <Image
                class="vcarousel__image"
                src={image.src}
                alt={image.alt}
                widths={[420, 640, 900]}
                sizes="40vw"
                loading="lazy"
                draggable="false"
              />
            </li>
          ))}
        </ul>
      </div>

      {images.length > 1 && (
        <div class="vcarousel__nav">
          <button class="vcarousel__button" type="button" aria-label="Prethodna slika" data-vcarousel-prev>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d="M6 15l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div class="vcarousel__dots">
            {images.map((_, index) => (
              <button
                class="vcarousel__dot"
                type="button"
                aria-label={`Slika ${index + 1}`}
                aria-current={index === 0 ? 'true' : undefined}
                data-vcarousel-dot={index}
              />
            ))}
          </div>
          <button class="vcarousel__button" type="button" aria-label="Sledeća slika" data-vcarousel-next>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      )}
    </div>
  )
}

<script>
  for (const carousel of document.querySelectorAll<HTMLElement>('[data-vcarousel]')) {
    const viewport = carousel.querySelector<HTMLElement>('[data-vcarousel-viewport]');
    const track = carousel.querySelector<HTMLElement>('[data-vcarousel-track]');
    if (!viewport || !track) continue;

    const slides = [...track.children] as HTMLElement[];
    const dots = [...carousel.querySelectorAll<HTMLButtonElement>('[data-vcarousel-dot]')];
    const prev = carousel.querySelector<HTMLButtonElement>('[data-vcarousel-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-vcarousel-next]');
    let index = 0;

    /** Distance between the tops of two neighbouring slides. */
    const step = () => (slides.length > 1 ? slides[1].offsetTop - slides[0].offsetTop : 0);
    const offset = (i: number) => -i * step();

    const go = (target: number) => {
      index = Math.max(0, Math.min(slides.length - 1, target));
      track.style.transform = `translate3d(0, ${offset(index)}px, 0)`;
      slides.forEach((slide, i) => slide.toggleAttribute('data-active', i === index));
      dots.forEach((dot, i) => dot.toggleAttribute('aria-current', i === index));
      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index === slides.length - 1;
    };

    prev?.addEventListener('click', () => go(index - 1));
    next?.addEventListener('click', () => go(index + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => go(i)));

    viewport.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') go(index + 1);
      else if (event.key === 'ArrowUp') go(index - 1);
      else return;
      event.preventDefault();
    });

    // Mouse drag only: touch keeps scrolling the page as normal.
    let dragStart: number | null = null;
    viewport.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.button !== 0) return;
      dragStart = event.clientY;
      viewport.setPointerCapture(event.pointerId);
      track.style.transition = 'none';
    });
    viewport.addEventListener('pointermove', (event) => {
      if (dragStart === null) return;
      track.style.transform = `translate3d(0, ${offset(index) + (event.clientY - dragStart)}px, 0)`;
    });
    const endDrag = (event: PointerEvent) => {
      if (dragStart === null) return;
      const distance = event.clientY - dragStart;
      dragStart = null;
      track.style.transition = '';
      go(Math.abs(distance) > 50 ? index + (distance < 0 ? 1 : -1) : index);
    };
    viewport.addEventListener('pointerup', endDrag);
    viewport.addEventListener('pointercancel', endDrag);

    // Slide sizes follow the layout; keep the current photo aligned after a resize.
    new ResizeObserver(() => {
      track.style.transition = 'none';
      go(index);
      requestAnimationFrame(() => (track.style.transition = ''));
    }).observe(viewport);
  }
</script>

<style>
  .vcarousel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
  }

  /*
   * Window sized from the photos' own proportions: its width is the column width (or
   * less on short screens, so a whole photo always fits on screen), each photo frame has
   * the photo's aspect ratio, and the window is that frame plus a small preview (--peek)
   * of the next photo. Nothing in the active photo is ever cut off.
   */
  .vcarousel__viewport {
    --peek: 0.16;

    justify-self: center;
    width: min(100%, 64svh * var(--ratio));
    aspect-ratio: calc(var(--ratio) / (1 + var(--peek)));
    overflow: hidden;
    border-radius: var(--radius-lg);
    cursor: grab;
    /* Only the preview below the active photo fades. */
    mask-image: linear-gradient(180deg, #000 0%, #000 calc(100% / (1 + var(--peek))), rgb(0 0 0 / 0.35) 100%);
    user-select: none;
  }

  .vcarousel__viewport:active {
    cursor: grabbing;
  }

  .vcarousel__viewport:focus-visible {
    outline-offset: 4px;
  }

  .vcarousel__track {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    transition: transform 700ms var(--ease-out);
    will-change: transform;
  }

  .vcarousel__slide {
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    opacity: 0.55;
    transform: scale(0.97);
    transition:
      opacity 700ms ease,
      transform 700ms var(--ease-out);
  }

  .vcarousel__slide[data-active] {
    opacity: 1;
    transform: none;
  }

  .vcarousel :global(.vcarousel__image) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    pointer-events: none;
  }

  /* ---------- Controls, stacked to the right of the photos ---------- */

  .vcarousel__nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .vcarousel__dots {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .vcarousel__dot {
    width: 0.625rem;
    height: 0.625rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-pink);
    cursor: pointer;
    transition:
      height var(--duration) var(--ease-out),
      background-color var(--duration) ease;
  }

  .vcarousel__dot[aria-current] {
    height: 1.5rem;
    background: var(--color-strawberry);
  }

  .vcarousel__button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
    color: var(--color-strawberry);
    cursor: pointer;
    transition:
      background-color var(--duration) ease,
      color var(--duration) ease,
      opacity var(--duration) ease;
  }

  .vcarousel__button:hover:not(:disabled) {
    background: var(--color-pink);
    color: var(--color-chocolate);
  }

  .vcarousel__button:disabled {
    opacity: 0.4;
    cursor: default;
  }
</style>
