---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary';

/** Renders a link when `href` is set, otherwise a button. */
type Props = {
  variant?: Variant;
  /** Adds a trailing arrow that slides on hover. */
  arrow?: boolean;
} & (({ href: string } & HTMLAttributes<'a'>) | ({ href?: undefined } & HTMLAttributes<'button'>));

const { variant = 'primary', arrow = false, class: className, ...rest } = Astro.props;
const classes = ['button', `button--${variant}`, className];
const Tag = rest.href !== undefined ? 'a' : 'button';
const tagProps: Record<string, unknown> = Tag === 'a' ? rest : { type: 'button', ...rest };
---

<Tag class:list={classes} {...tagProps}>
  <slot />
  {
    arrow && (
      <svg class="button__arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M4 12h16M14 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )
  }
</Tag>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
    padding: 1rem 1.75rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.02em;
    color: var(--color-text);
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--duration) ease,
      border-color var(--duration) ease,
      box-shadow var(--duration) ease,
      transform var(--duration) var(--ease-out);
  }

  .button:hover {
    box-shadow: 0 0.875rem 1.5rem -0.875rem rgb(47 47 47 / 0.4);
    transform: translateY(-2px);
  }

  .button:active {
    box-shadow: none;
    transform: none;
  }

  .button__arrow {
    flex: none;
    transition: transform var(--duration) var(--ease-out);
  }

  .button:hover .button__arrow {
    transform: translateX(0.3125rem);
  }

  .button--primary {
    background: var(--color-mint);
  }

  .button--primary:hover {
    background: var(--color-mint-strong);
  }

  .button--secondary {
    border-color: var(--color-text);
    background: transparent;
  }

  .button--secondary:hover {
    background: var(--color-surface);
  }
</style>
