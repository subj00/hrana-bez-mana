---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary';

/** Renders a link when `href` is set, otherwise a button. */
type Props = {
  variant?: Variant;
  /** Adds a trailing arrow chip that reacts on hover. */
  arrow?: boolean;
} & (({ href: string } & HTMLAttributes<'a'>) | ({ href?: undefined } & HTMLAttributes<'button'>));

const { variant = 'primary', arrow = false, class: className, ...rest } = Astro.props;
const classes = ['button', `button--${variant}`, arrow && 'button--arrow', className];
const Tag = rest.href !== undefined ? 'a' : 'button';
const tagProps: Record<string, unknown> = Tag === 'a' ? rest : { type: 'button', ...rest };
---

<Tag class:list={classes} {...tagProps}>
  <slot />
  {
    arrow && (
      <span class="button__chip" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16">
          <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    )
  }
</Tag>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
    padding: 0.875rem 1.75rem;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--duration) ease,
      box-shadow var(--duration) ease,
      transform var(--duration) var(--ease-out);
  }

  /* The chip sits flush in the pill's right end, so the padding is lopsided on purpose. */
  .button--arrow {
    padding: 0.375rem 0.375rem 0.375rem 1.5rem;
  }

  .button:hover {
    box-shadow: var(--shadow-float);
    transform: translateY(-2px);
  }

  .button:active {
    box-shadow: none;
    transform: none;
  }

  .button__chip {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.375rem;
    height: 2.375rem;
    border-radius: 50%;
    background: var(--color-pink);
    color: var(--color-chocolate);
  }

  .button__chip svg {
    transition: transform var(--duration) var(--ease-out);
  }

  .button:hover .button__chip svg {
    transform: translateX(2px);
  }

  .button--primary {
    background: var(--color-chocolate);
    color: var(--color-cream-white);
  }

  .button--secondary {
    border-color: var(--color-border);
    background: var(--color-surface);
    color: var(--color-chocolate);
  }
</style>
