---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  /** Accessible name for the carousel region. */
  label: string;
}

const { images, label } = Astro.props;
---

<!--
  Image-only carousel built on native horizontal scrolling with scroll snapping, so touch
  swiping works without extra code. The buttons and dots below drive the same scroll.
  No autoplay. Shows 2 images on phones, 3 on tablets, 4 on wide screens.
-->
{
  images.length > 0 && (
    <div class="carousel" role="region" aria-roledescription="karusel" aria-label={label} data-carousel>
      <ul class="carousel__track" role="list" tabindex="0" data-carousel-track>
        {images.map((image, index) => (
          <li class="carousel__slide" aria-label={`${index + 1} od ${images.length}`}>
            <Image
              class="carousel__image"
              src={image.src}
              alt={image.alt}
              widths={[280, 420, 640]}
              sizes="(max-width: 48rem) 46vw, (max-width: 72rem) 31vw, 18rem"
              loading="lazy"
            />
          </li>
        ))}
      </ul>

      <div class="carousel__controls" data-carousel-controls>
        <button class="carousel__button" type="button" aria-label="Prethodne slike" data-carousel-prev>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div class="carousel__dots" data-carousel-dots />
        <button class="carousel__button" type="button" aria-label="Sledeće slike" data-carousel-next>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </div>
  )
}

<script>
  for (const carousel of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
    const controls = carousel.querySelector<HTMLElement>('[data-carousel-controls]');
    const dots = carousel.querySelector<HTMLElement>('[data-carousel-dots]');
    const prev = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!track || !controls || !dots || !prev || !next) continue;

    const slides = [...track.children] as HTMLElement[];

    /** Distance from one slide to the next, and how many start positions there are. */
    const measure = () => {
      const step = slides.length > 1 ? slides[1].offsetLeft - slides[0].offsetLeft : track.clientWidth;
      const perView = Math.max(1, Math.round(track.clientWidth / step));
      return { step, positions: Math.max(1, slides.length - perView + 1) };
    };

    const current = () => Math.round(track.scrollLeft / measure().step);
    const goTo = (index: number) => track.scrollTo({ left: index * measure().step, behavior: 'smooth' });

    // One dot per position the row can start at.
    const buildDots = () => {
      const { positions } = measure();
      dots.replaceChildren(
        ...Array.from({ length: positions }, (_, index) => {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'carousel__dot';
          dot.setAttribute('aria-label', `Idi na sliku ${index + 1}`);
          dot.addEventListener('click', () => goTo(index));
          return dot;
        }),
      );
      // Everything already fits: no controls needed.
      controls.hidden = positions <= 1;
      update();
    };

    const update = () => {
      const { positions } = measure();
      const index = Math.min(current(), positions - 1);
      dots.querySelectorAll('button').forEach((dot, i) => dot.toggleAttribute('aria-current', i === index));
      prev.disabled = index <= 0;
      next.disabled = index >= positions - 1;
    };

    prev.addEventListener('click', () => goTo(current() - 1));
    next.addEventListener('click', () => goTo(current() + 1));
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    new ResizeObserver(buildDots).observe(track);
  }
</script>

<style>
  .carousel {
    --per-view: 2;
    --gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  @media (min-width: 48rem) {
    .carousel {
      --per-view: 3;
    }
  }

  @media (min-width: 72rem) {
    .carousel {
      --per-view: 4;
    }
  }

  .carousel__track {
    display: grid;
    grid-auto-columns: calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
    grid-auto-flow: column;
    gap: var(--gap);
    /* Room for the shadows, which the scroll box would otherwise clip. */
    padding-block: 0.5rem 1.25rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .carousel__track::-webkit-scrollbar {
    display: none;
  }

  .carousel__track:focus-visible {
    border-radius: var(--radius);
    outline-offset: 4px;
  }

  .carousel__slide {
    scroll-snap-align: start;
  }

  .carousel :global(.carousel__image) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    transition:
      transform 400ms var(--ease-out),
      box-shadow 400ms ease;
  }

  @media (hover: hover) {
    .carousel :global(.carousel__image:hover) {
      box-shadow: var(--shadow-float);
      transform: translateY(-4px);
    }
  }

  /*
   * Phones and tablets: show each photo whole. The frame takes the photo's own
   * proportions instead of a fixed crop, and softer corners keep the edges of the cake
   * and plate visible.
   */
  @media (max-width: 63.99rem) {
    .carousel__slide {
      align-self: center;
    }

    .carousel :global(.carousel__image) {
      aspect-ratio: auto;
      object-fit: contain;
      border-radius: var(--radius);
    }
  }

  /* ---------- Controls ---------- */

  .carousel__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .carousel__controls[hidden] {
    display: none;
  }

  .carousel__button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
    color: var(--color-strawberry);
    cursor: pointer;
    transition:
      background-color var(--duration) ease,
      color var(--duration) ease,
      opacity var(--duration) ease,
      transform var(--duration) var(--ease-out);
  }

  .carousel__button:hover:not(:disabled) {
    background: var(--color-pink);
    color: var(--color-chocolate);
    transform: translateY(-2px);
  }

  .carousel__button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .carousel__dots {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  /* :global because the dots are created by the script. */
  .carousel__dots :global(.carousel__dot) {
    width: 0.625rem;
    height: 0.625rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-pink);
    cursor: pointer;
    transition:
      width var(--duration) var(--ease-out),
      background-color var(--duration) ease;
  }

  .carousel__dots :global(.carousel__dot[aria-current]) {
    width: 1.5rem;
    background: var(--color-strawberry);
  }
</style>
