---
import Container from '@/components/ui/Container.astro';

interface Props {
  /** Anchor target used by the navigation. */
  id: string;
  title: string;
  headingLevel?: 1 | 2;
}

const { id, title, headingLevel = 2 } = Astro.props;

const Heading = `h${headingLevel}` as const;
const headingId = `${id}-naslov`;
---

<section id={id} aria-labelledby={headingId}>
  <Container>
    <Heading id={headingId} data-reveal>{title}</Heading>
    <slot />
  </Container>
</section>

<style>
  section {
    padding-block: var(--space-xl);
  }
</style>
