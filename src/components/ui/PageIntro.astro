---
interface Props {
  title: string;
  lead?: string;
}

const { title, lead } = Astro.props;
---

<!-- Centered page heading used by the inner pages. Slot: optional line above the title. -->
<header class="intro">
  <slot />
  <h1 class="intro__title">{title}</h1>
  {lead && <p class="intro__lead">{lead}</p>}
</header>

<style>
  .intro {
    display: grid;
    justify-items: center;
    gap: var(--space-md);
    padding-block: clamp(1rem, 4vw, 2.5rem) clamp(1.5rem, 4vw, 3rem);
    text-align: center;
    animation: fade-up 800ms var(--ease-out) backwards;
  }

  .intro__title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 700;
  }

  .intro__lead {
    max-width: 34rem;
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    color: var(--color-text-muted);
  }
</style>
