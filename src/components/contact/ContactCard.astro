---
import Button from '@/components/ui/Button.astro';
import { site } from '@/data/site';

const { phone, email, address } = site.contact;
const hasDetails = Boolean(phone || email || address);
---

<!-- Renders only the contact details that are actually set in data/site.ts. -->
<div class="contact">
  {
    hasDetails ? (
      <address class="contact__details">
        <dl>
          {phone && (
            <div class="contact__row">
              <dt>Telefon</dt>
              <dd>
                <a href={`tel:${phone.replace(/[^\d+]/g, '')}`}>{phone}</a>
              </dd>
            </div>
          )}
          {email && (
            <div class="contact__row">
              <dt>Email</dt>
              <dd>
                <a href={`mailto:${email}`}>{email}</a>
              </dd>
            </div>
          )}
          {address && (
            <div class="contact__row">
              <dt>Adresa</dt>
              <dd>{address}</dd>
            </div>
          )}
        </dl>
      </address>
    ) : (
      <p class="contact__placeholder">Kontakt podaci će uskoro biti objavljeni.</p>
    )
  }

  <div class="contact__social">
    <p>Pratite nas na Instagramu</p>
    <Button href={site.instagramUrl} target="_blank" rel="noopener noreferrer" arrow>Instagram</Button>
  </div>
</div>

<style>
  .contact {
    display: grid;
    gap: var(--space-lg);
    width: min(100%, 36rem);
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: linear-gradient(170deg, var(--color-cream-white) 0%, var(--color-blush) 160%);
    box-shadow:
      var(--shadow-soft),
      inset 0 0 0 1px rgb(255 255 255 / 0.8);
    text-align: center;
  }

  .contact__details {
    font-style: normal;
  }

  .contact__details dl {
    display: grid;
    gap: var(--space-md);
  }

  .contact__row dt {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .contact__row dd {
    font-size: 1.125rem;
  }

  .contact__placeholder {
    color: var(--color-text-muted);
  }

  .contact__social {
    display: grid;
    justify-items: center;
    gap: var(--space-md);
    font-family: var(--font-display);
    font-weight: 500;
  }
</style>
