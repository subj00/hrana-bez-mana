---
import Icon from '@/components/ui/Icon.astro';

interface Props {
  href: string;
  /** Small line above the value, e.g. "Pozovite nas". */
  label: string;
  value: string;
  icon: 'instagram' | 'phone';
  /** Opens in a new tab (for links away from the site). */
  external?: boolean;
  /** Larger, more prominent card (the Instagram card). */
  featured?: boolean;
}

const { href, label, value, icon, external = false, featured = false } = Astro.props;
---

<!-- One contact card; the whole card is the link. -->
<a
  class:list={['link', { 'link--featured': featured }]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  aria-label={`${label}: ${value}${external ? ' (otvara se u novoj kartici)' : ''}`}
>
  <span class="link__icon" aria-hidden="true">
    <Icon name={icon} />
  </span>
  <span class="link__text">
    <span class="link__label">{label}</span>
    <span class="link__value">{value}</span>
  </span>
  <span class="link__arrow" aria-hidden="true">
    <Icon name="arrow" size={18} />
  </span>
</a>

<style>
  /* Frosted cream card with a delicate white edge; glows pink on hover. */
  .link {
    --icon-size: 3.25rem;

    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(0.875rem, 2.5vw, 1.25rem);
    height: 100%;
    min-height: 5.25rem;
    padding: clamp(1rem, 2.5vw, 1.25rem) clamp(1rem, 3vw, 1.5rem);
    border: 1px solid rgb(255 255 255 / 0.9);
    border-radius: 2rem;
    background: linear-gradient(135deg, rgb(255 252 248 / 0.88) 0%, rgb(251 229 225 / 0.62) 100%);
    box-shadow:
      0 1px 2px rgb(69 39 28 / 0.04),
      0 1rem 2rem -1.25rem rgb(232 141 148 / 0.45);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    text-decoration: none;
    transition:
      transform 400ms var(--ease-out),
      box-shadow 400ms ease,
      border-color 400ms ease;
  }

  .link--featured {
    --icon-size: clamp(3.5rem, 8vw, 4.25rem);

    padding: clamp(1.25rem, 3vw, 1.75rem) clamp(1.25rem, 3.5vw, 2rem);
    border-radius: 2.25rem;
  }

  /* Circular icon on a soft pink gradient that shifts gently on hover. */
  .link__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: var(--icon-size);
    height: var(--icon-size);
    border-radius: 50%;
    background: linear-gradient(135deg, #fdeeea 0%, var(--color-pink) 50%, #fdeeea 100%) 0% 0% / 200% 200%;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.8);
    color: var(--color-strawberry);
    transition:
      background-position 700ms ease,
      transform 400ms var(--ease-out);
  }

  .link__icon :global(svg) {
    width: 46%;
    height: 46%;
  }

  .link__text {
    display: grid;
    flex: 1;
    gap: 0.125rem;
    min-width: 0;
  }

  .link__label {
    font-size: clamp(0.8125rem, 2.6vw, 0.9375rem);
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .link__value {
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 4.2vw, 1.25rem);
    font-weight: 700;
    line-height: 1.25;
    white-space: nowrap;
  }

  .link--featured .link__value {
    font-size: clamp(1.1875rem, 4.6vw, 1.625rem);
    font-weight: 800;
  }

  .link__arrow {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.75);
    box-shadow: inset 0 0 0 1px rgb(246 199 205 / 0.7);
    color: var(--color-strawberry);
    transition:
      background-color 400ms ease,
      color 400ms ease;
  }

  .link__arrow :global(svg) {
    transition: transform 400ms var(--ease-out);
  }

  @media (hover: hover) {
    .link:hover {
      border-color: rgb(246 199 205 / 0.9);
      box-shadow:
        0 0 0 4px rgb(246 199 205 / 0.28),
        0 1.5rem 2.75rem -1.25rem rgb(232 141 148 / 0.6);
      transform: translateY(-4px);
    }

    .link:hover .link__icon {
      background-position: 100% 100%;
      transform: scale(1.06);
    }

    .link:hover .link__arrow {
      background: var(--color-strawberry);
      color: var(--color-cream-white);
    }

    .link:hover .link__arrow :global(svg) {
      transform: translateX(3px);
    }
  }

  .link:active {
    transform: scale(0.985);
  }
</style>
