---
import { Image } from 'astro:assets';
import ImageCarousel from '@/components/ui/ImageCarousel.astro';
import Section from '@/components/ui/Section.astro';
import VerticalCarousel from '@/components/ui/VerticalCarousel.astro';
import { cakeCoatings, cakeGallery, cakeHighlights } from '@/data/cakes';
import { getAsset } from '@/lib/assets';
import type { Category } from '@/types/catalog';

interface Props {
  category: Category;
}

const { category } = Astro.props;
const titleImage = category.titleImage && typeof category.titleImage.src !== 'string' ? category.titleImage.src : undefined;

const highlights = cakeHighlights.map((highlight) => ({ ...highlight, src: getAsset(highlight.image) }));

const gallery = cakeGallery.flatMap((file, index) => {
  const src = getAsset(file);
  return src ? [{ src, alt: `Primer torte ${index + 1}` }] : [];
});
---

<!--
  Torte: the price card on the left, a vertical photo carousel on the right (desktop).
  Below 64rem it becomes one column — the card, then a horizontal swipe gallery.
  Without photos, the card sits centred on its own.
-->
<Section id={category.slug} title={category.name} titleImage={titleImage}>
  <div class:list={['torte', { 'torte--gallery': gallery.length > 0 }]}>
    <article class="torte__card" data-reveal="left">
      <p class="torte__lead">Sve torte izrađujemo po dogovoru, sa pažljivo biranim ukusima i dekoracijama.</p>

      <h3 class="sr-only">Cene</h3>
      <ul class="torte__prices" role="list">
        {
          cakeCoatings.map((coating, index) => (
            <li class="price" style={`--i: ${index}`}>
              <span class="price__name">{coating.name}</span>
              <span class="price__badge">{coating.pricePerKg} din/kg</span>
            </li>
          ))
        }
      </ul>

      <ul class="torte__highlights" role="list">
        {
          highlights.map((highlight, index) => (
            <li class="highlight" style={`--i: ${index}`}>
              {highlight.src && <Image class="highlight__image" src={highlight.src} alt="" widths={[160, 320]} sizes="6rem" />}
              <p class="highlight__text">{highlight.text}</p>
            </li>
          ))
        }
      </ul>
    </article>

    {
      gallery.length > 0 && (
        <div class="torte__gallery" data-reveal="right" style="--reveal-delay: 150ms">
          <div class="torte__gallery-vertical">
            <VerticalCarousel images={gallery} label="Primeri naših torti" />
          </div>
          <div class="torte__gallery-horizontal">
            <ImageCarousel images={gallery} label="Primeri naših torti" />
          </div>
        </div>
      )
    }
  </div>
</Section>

<style>
  .torte {
    display: grid;
    justify-items: center;
    gap: clamp(1.75rem, 4vw, 2.5rem);
  }

  .torte__card {
    display: grid;
    gap: clamp(1.25rem, 3vw, 1.75rem);
    width: min(100%, 36rem);
    padding: clamp(1.25rem, 4vw, 2.25rem);
    border-radius: 2rem;
    background: rgb(255 252 248 / 0.8);
    box-shadow:
      var(--shadow-soft),
      inset 0 0 0 1px rgb(255 255 255 / 0.9);
  }

  .torte__lead {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.6vw, 1.1875rem);
    font-weight: 600;
    line-height: 1.5;
    text-align: center;
  }

  /* ---------- Prices: rows inside the card, separated by hairlines ---------- */

  .torte__prices {
    display: grid;
  }

  .price {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: 0.875rem 0.25rem;
  }

  .price + .price {
    border-top: 1px solid rgb(69 39 28 / 0.08);
  }

  .price__name {
    min-width: 0;
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 3.6vw, 1.1875rem);
    font-weight: 700;
    line-height: 1.25;
  }

  .price__badge {
    flex: none;
    padding: 0.5rem clamp(0.75rem, 3vw, 1.125rem);
    border-radius: var(--radius-pill);
    background: linear-gradient(135deg, var(--color-pink) 0%, #f2b0b8 100%);
    font-family: var(--font-display);
    font-size: clamp(0.875rem, 3.2vw, 1.0625rem);
    font-weight: 800;
    white-space: nowrap;
    transition: transform var(--duration) var(--ease-out);
  }

  @media (hover: hover) {
    .price:hover .price__badge {
      transform: scale(1.05);
    }
  }

  /* ---------- Highlights: two small pink tiles ---------- */

  .torte__highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 2.5vw, 1rem);
  }

  .highlight {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    height: 100%;
    min-height: clamp(6.5rem, 22vw, 8.5rem);
    padding: clamp(0.875rem, 3vw, 1.25rem) clamp(0.75rem, 2.5vw, 1rem);
    border-radius: var(--radius-lg);
    background: var(--tone-blush);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.6);
    text-align: center;
  }

  .torte :global(.highlight__image) {
    width: auto;
    height: clamp(3rem, 11vw, 4.5rem);
    object-fit: contain;
    filter: drop-shadow(0 0.5rem 0.75rem rgb(69 39 28 / 0.12));
  }

  .highlight__text {
    font-family: var(--font-display);
    font-size: clamp(0.875rem, 3.2vw, 1.0625rem);
    font-weight: 700;
    line-height: 1.3;
  }

  /*
   * Scroll reveal inside the card: once the card slides in, its price rows follow one
   * by one, then the two tiles scale up one after the other.
   */
  :global([data-reveal-ready]) .price,
  :global([data-reveal-ready]) .highlight {
    transition:
      opacity var(--reveal-duration) var(--ease-out),
      transform var(--reveal-duration) var(--ease-out);
  }

  :global([data-reveal-ready]) .price {
    transition-delay: calc(200ms + var(--i) * var(--reveal-stagger));
  }

  :global([data-reveal-ready]) .highlight {
    transition-delay: calc(560ms + var(--i) * var(--reveal-stagger));
  }

  :global([data-reveal-ready]) .torte__card:not([data-revealed]) .price {
    opacity: 0;
    transform: translate3d(0, 0.75rem, 0);
  }

  :global([data-reveal-ready]) .torte__card:not([data-revealed]) .highlight {
    opacity: 0;
    transform: scale(0.92);
  }

  /* ---------- Gallery ---------- */

  .torte__gallery {
    width: 100%;
  }

  .torte__gallery-vertical {
    display: none;
  }

  /* Desktop: card 45%, photos 55%, side by side. */
  @media (min-width: 64rem) {
    .torte--gallery {
      grid-template-columns: minmax(0, 45fr) minmax(0, 55fr);
      align-items: center;
      gap: clamp(2rem, 4vw, 4rem);
    }

    .torte--gallery .torte__card {
      width: 100%;
    }

    .torte__gallery-vertical {
      display: block;
    }

    .torte__gallery-horizontal {
      display: none;
    }
  }
</style>
