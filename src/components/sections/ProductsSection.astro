---
import ProductCategory from '@/components/products/ProductCategory.astro';
import Section from '@/components/ui/Section.astro';
import { SECTION_IDS } from '@/data/navigation';
import { getCatalog } from '@/lib/catalog';

const catalog = await getCatalog();
---

<Section id={SECTION_IDS.products} title="Proizvodi">
  {catalog.map(({ category, products }) => <ProductCategory category={category} products={products} />)}
</Section>
