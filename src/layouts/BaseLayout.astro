---
import { Font } from 'astro:assets';
import CakeLoader from '@/components/layout/CakeLoader.astro';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import { site } from '@/data/site';
import '@/styles/global.css';

interface Props {
  /** Page-specific title; the site name is appended automatically. */
  title?: string;
  description?: string;
  /** Path or URL of the social sharing image. */
  image?: string;
}

const { title, description = site.description, image } = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : site.name;
// Absolute URLs need `site` in astro.config.mjs; omitted until it is set.
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const imageUrl = image ? new URL(image, Astro.site ?? Astro.url) : undefined;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Runs before first paint:
      - the "js" class lets CSS tell whether the navigation scripts can run (Header.astro);
      - data-loader="play" shows the cake intro (CakeLoader.astro) on the first page of a
        visit only, and never for visitors who prefer reduced motion.
    -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        try {
          const seen = sessionStorage.getItem('hbm-loader-seen');
          const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!seen && !calm) root.dataset.loader = 'play';
          // Scroll reveals only hide content when they will be able to show it again.
          if (!calm && 'IntersectionObserver' in window) root.setAttribute('data-reveal-ready', '');
        } catch {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-jost" preload />
    <Font cssVariable="--font-nunito" preload />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.ogLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
  </head>
  <body>
    <CakeLoader />
    <a class="skip-link" href="#sadrzaj">Preskoči na sadržaj</a>
    <Header />
    <main id="sadrzaj">
      <slot />
    </main>
    <Footer />

    <!--
      Scroll reveals: marks [data-reveal] elements as revealed the first time they scroll
      into view (styles in animations.css). Starts once the cake intro has finished, so
      nothing animates unseen behind it.
    -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        if (!root.hasAttribute('data-reveal-ready')) return;

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.setAttribute('data-revealed', '');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
        );

        const start = () => {
          for (const element of document.querySelectorAll('[data-reveal]')) observer.observe(element);
        };

        if (root.dataset.loader === 'play') {
          const waiting = new MutationObserver(() => {
            if (root.dataset.loader === 'play') return;
            waiting.disconnect();
            start();
          });
          waiting.observe(root, { attributes: true, attributeFilter: ['data-loader'] });
        } else {
          start();
        }
      })();
    </script>
  </body>
</html>
